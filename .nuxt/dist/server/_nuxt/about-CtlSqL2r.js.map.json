{"file":"about-CtlSqL2r.js","mappings":";;;;;;;;;;;;;;;;;;AAuDE,MAAK,YAAU;AAAA,EACb,MAAM;AAAA,EACN,OAAO;AACL,WAAO;AAAA,MACL,SAAS;AAAA,QACP;AAAA,UACE,IAAI;AAAA,UACJ,MAAM;AAAA,UACN,MAAM;AAAA,UACN,OAAO;AAAA,QACR;AAAA,QACD;AAAA,UACE,IAAI;AAAA,UACJ,MAAM;AAAA,UACN,MAAM;AAAA,UACN,OAAO;AAAA,QACR;AAAA,QACD;AAAA,UACE,IAAI;AAAA,UACJ,MAAM;AAAA,UACN,MAAM;AAAA,UACN,OAAO;AAAA,QACR;AAAA,MACF;AAAA,IACF;AAAA,EACF;AACF;;AAjFH,QAAA,OAAAA,eAAAC,WAAA,EACS,OAAM,cADf,MAAA,CAAA,CAAA,i+BAAA;AAAAC,gBA0B+C,MAAA,SA1B/C,CA0BqC,WAAM;AA1B3C,UAAA,2CAAAC,cA2BkB,OAAK,OAAO,KAAK,IA3BnCA,cA2BsC,OAAK,OAAO,IAAI,8DA3BtDC,eA4BmB,OAAO,IAAI,4BA5B9BA,eA6BkB,OAAO,IAAI;;AA7B7B,QAAA,kvBAAA;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_ssrRenderList","_ssrRenderAttr","_ssrInterpolate"],"sources":["../../../../pages/about.vue"],"sourcesContent":["<template>\n    <div class=\"about-us\">\n      <section class=\"hero-section\">\n        <h1 class=\"hero-title\">Welcome to Our Church</h1>\n        <p class=\"hero-description\">\n          We are a community of faith, hope, and love, dedicated to serving God and our neighbors.\n        </p>\n      </section>\n  \n      <section class=\"mission-section\">\n        <h2>Our Mission</h2>\n        <p>\n          Our mission is to glorify God by leading people into a growing relationship with Jesus Christ, equipping them to serve and share His love with the world.\n        </p>\n      </section>\n  \n      <section class=\"history-section\">\n        <h2>Our History</h2>\n        <p>\n          Established in 2000, our church has been a beacon of hope and faith for generations. From humble beginnings, we have grown into a vibrant community dedicated to making a difference.\n        </p>\n      </section>\n  \n      <section class=\"leadership-section\">\n        <h2>Meet Our Leadership</h2>\n        <div class=\"leaders\">\n          <div class=\"leader\" v-for=\"leader in leaders\" :key=\"leader.id\">\n            <img :src=\"leader.photo\" :alt=\"leader.name\" class=\"leader-photo\" />\n            <h3>{{ leader.name }}</h3>\n            <p>{{ leader.role }}</p>\n          </div>\n        </div>\n      </section>\n  \n      <section class=\"services-section\">\n        <h2>Service Times</h2>\n        <ul>\n          <li><strong>Sunday Worship:</strong> 10:00 AM</li>\n          <li><strong>Bible Study:</strong> Wednesday, 7:00 PM</li>\n          <li><strong>Youth Fellowship:</strong> Friday, 6:00 PM</li>\n        </ul>\n      </section>\n  \n      <section class=\"contact-section\">\n        <h2>Contact Us</h2>\n        <p>\n          <strong>Address:</strong> Uganda road, Eldoret City<br />\n          <strong>Phone:</strong> (123) 456-7890<br />\n          <strong>Email:</strong> info@ourchurch.com\n        </p>\n      </section>\n    </div>\n  </template>\n  \n  <script>\n  export default {\n    name: \"AboutUs\",\n    data() {\n      return {\n        leaders: [\n          {\n            id: 1,\n            name: \"Pastor John Smith\",\n            role: \"Senior Pastor\",\n            photo: \"/images/pastor-john.jpg\",\n          },\n          {\n            id: 2,\n            name: \"Jane Doe\",\n            role: \"Youth Ministry Leader\",\n            photo: \"/images/jane-doe.jpg\",\n          },\n          {\n            id: 3,\n            name: \"Michael Brown\",\n            role: \"Worship Leader\",\n            photo: \"/images/michael-brown.jpg\",\n          },\n        ],\n      };\n    },\n  };\n  </script>\n  \n  <style scoped>\n  .about-us {\n    font-family: Arial, sans-serif;\n    padding: 20px;\n    color: #333;\n  }\n  \n  .hero-section {\n    text-align: center;\n    padding: 40px 20px;\n    background-color: #f9f9f9;\n  }\n  \n  .hero-title {\n    font-size: 2.5rem;\n    margin-bottom: 10px;\n  }\n  \n  .hero-description {\n    font-size: 1.2rem;\n    margin-bottom: 20px;\n  }\n  \n  .mission-section,\n  .history-section,\n  .leadership-section,\n  .services-section,\n  .contact-section {\n    margin-bottom: 30px;\n  }\n  \n  h2 {\n    font-size: 1.8rem;\n    margin-bottom: 15px;\n    color: #0056b3;\n  }\n  \n  p {\n    line-height: 1.6;\n  }\n  \n  .leaders {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 20px;\n  }\n  \n  .leader {\n    text-align: center;\n    width: 200px;\n  }\n  \n  .leader-photo {\n    width: 100%;\n    height: auto;\n    border-radius: 50%;\n    margin-bottom: 10px;\n  }\n  \n  ul {\n    list-style-type: none;\n    padding: 0;\n  }\n  \n  ul li {\n    margin-bottom: 10px;\n  }\n  \n  .contact-section p {\n    line-height: 1.8;\n  }\n  </style>\n  "],"version":3}